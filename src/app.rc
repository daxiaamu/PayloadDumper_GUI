#include <windows.h>
#include "resource.h"
#include "version.h"
IDI_APP ICON "../assets/app.ico"
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
 FILEVERSION APP_VERSION_RESOURCE
 PRODUCTVERSION APP_VERSION_RESOURCE
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Payload Dumper"
   VALUE "FileVersion", APP_VERSION_NAME
   VALUE "ProductName", "Payload Dumper"
   VALUE "ProductVersion", APP_VERSION_NAME
   VALUE "OriginalFilename", "PayloadDumperGUI.exe"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
